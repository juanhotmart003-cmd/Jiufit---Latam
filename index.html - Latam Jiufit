img{height:auto}
/* Layout: mesmo formato da página validada de manuais (fundo claro, coluna estreita, serifa nos títulos, seções escuras na oferta), com o vermelho IALA no lugar do roxo. */
:root{
  --ink:#1d1416; --text:#3d3335; --mute:#7c7072;
  --bg:#ffffff; --tint:#fbf2f2; --tint2:#f7e6e6;
  --dark:#1c1012; --accent:#d4141c; --accent-soft:#fde3e4;
  --gold:#b8892b; --gold-bg:#fbf3e1; --green:#1f9a50; --green-d:#177a3f;
  --line:#efe6e6;
  --serif:"Fraunces",Georgia,"Times New Roman",serif;
  --sans:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
body{margin:0;overflow-x:clip;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
.wrap{max-width:780px;margin:0 auto;padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px))}
section{padding-block:56px}
.tint{background:var(--tint)}
.darksec{background:var(--dark)}
h1,h2,h3{font-family:var(--serif);color:var(--ink);margin:0;line-height:1.15;text-wrap:balance;font-weight:700}
h1{font-size:clamp(30px,5.4vw,42px)}
h1 em,h2 em{color:var(--accent);font-style:italic}
h2{font-size:clamp(25px,4.2vw,32px);text-align:center}
.lead{text-align:center;color:var(--mute);max-width:52ch;margin:10px auto 0;font-size:14.5px}
p{margin:0}

.btn{display:inline-flex;align-items:center;justify-content:center;background:var(--green);color:#fff;font-weight:800;font-size:15px;text-transform:uppercase;letter-spacing:.3px;text-decoration:none;padding:16px 26px;border-radius:999px;box-shadow:0 6px 18px rgba(31,154,80,.35);transition:transform .15s,background .15s}
.btn:hover{background:var(--green-d);transform:translateY(-1px)}
.btn:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.pulse{animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(1.035)}}
@media (prefers-reduced-motion:reduce){.pulse{animation:none}}

/* barra */
.topbar{background:var(--dark);color:#fff;text-align:center;font-weight:700;font-size:12.5px;padding-block:8px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* hero */
.hero{text-align:center;padding-block:40px 48px;background:linear-gradient(180deg,var(--tint),#fff)}
.hero .lead{font-size:15px;margin-top:12px}
.vsl{position:relative;display:block;max-width:620px;margin:26px auto 0;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#000;box-shadow:0 18px 40px rgba(29,20,22,.18)}
.vsl img{width:100%;height:100%;object-fit:cover;object-position:50% 25%}
.vsl iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.play{position:absolute;inset:0;display:grid;place-items:center}
.play span{width:74px;height:74px;border-radius:50%;background:var(--accent);display:grid;place-items:center;box-shadow:0 0 0 9px rgba(212,20,28,.25)}
.play svg{width:30px;fill:#fff;margin-left:4px}
.vsl:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.spark{margin-top:18px;font-weight:700;color:var(--ink);font-size:13.5px}
.spark b{color:var(--accent)}
.hero .btn{margin-top:20px}

/* cards entregáveis */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px 16px 18px;text-align:center;box-shadow:0 6px 20px rgba(29,20,22,.06);display:flex;flex-direction:column;align-items:center;gap:6px;position:relative;min-width:0}
.card .ico{width:58px;height:58px;border-radius:14px;background:var(--accent-soft);display:grid;place-items:center;font-size:28px;margin-bottom:6px}
.card .lbl{font-family:var(--serif);font-style:italic;color:var(--gold);font-size:13px}
.card h3{font-size:16.5px}
.card p{font-size:13px;color:var(--mute)}
.card.feat{border:1.5px solid var(--accent)}
.card .pill{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;white-space:nowrap}

/* galeria */
.gal{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:28px}
.gal img{width:100%;aspect-ratio:194/221;object-fit:cover;border-radius:8px;box-shadow:0 4px 12px rgba(29,20,22,.12);display:block}

/* momentos */
.moments h3{text-align:center;font-size:20px}
.minis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:18px}
.mini{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 8px;text-align:center;font-size:12px;font-weight:700;color:var(--ink);box-shadow:0 4px 14px rgba(29,20,22,.05);display:flex;flex-direction:column;gap:6px;align-items:center;line-height:1.3;min-width:0}
.mini span{font-size:20px}
.incl{margin-top:22px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:0 6px 20px rgba(29,20,22,.06)}
.incl h3{text-align:center;font-size:18px;margin-bottom:12px}
.ck{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:0 22px}
.ck li{font-size:13px;color:var(--ink);font-weight:500;padding:7px 0;border-bottom:1px solid var(--line);display:flex;gap:8px}
.ck li::before{content:"✅";font-size:12px}
.band{margin-top:44px;background:linear-gradient(90deg,#a50f16,var(--accent) 60%,#e8434a);color:#fff;text-align:center;font-family:var(--serif);font-weight:700;font-size:17px;padding-block:16px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* benefícios */
.bens{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}
.ben{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px 18px;box-shadow:0 4px 14px rgba(29,20,22,.05);min-width:0}
.ben-h{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.ben-h span{width:30px;height:30px;border-radius:8px;background:var(--accent-soft);display:grid;place-items:center;font-size:15px;flex:none}
.ben-h h3{font-size:15px}
.ben p{font-size:12.5px;color:var(--mute)}
.ideal{margin-top:16px;background:var(--dark);border-radius:14px;padding:20px 22px;color:#fff}
.ideal h3{color:#fff;text-align:center;font-size:17px;margin-bottom:10px}
.ideal ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:8px 20px}
.ideal li{font-size:13px;font-weight:600;display:flex;gap:8px}
.ideal li::before{content:"✅";font-size:12px}

/* bônus */
.bonus{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px}
.bcard{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 16px 18px;text-align:center;box-shadow:0 6px 20px rgba(29,20,22,.06);display:flex;flex-direction:column;align-items:center;gap:8px;min-width:0}
.bimg{width:100%;aspect-ratio:4/3;border-radius:10px;background:#111;display:grid;place-items:center;overflow:hidden}
.bimg img{max-width:88%;max-height:88%;object-fit:contain}
.bnum{background:var(--dark);color:#fff;font-size:11px;font-weight:800;padding:3px 10px;border-radius:999px;letter-spacing:.5px}
.bcard h3{font-size:15.5px}
.bcard p{font-size:12.5px;color:var(--mute)}
.val{background:var(--accent-soft);color:var(--ink);font-size:12px;font-weight:700;padding:4px 12px;border-radius:999px}
.val s{color:var(--accent)}
.val b{color:var(--green)}
.total{max-width:380px;margin:24px auto 0;background:var(--gold-bg);border:1.5px dashed var(--gold);border-radius:12px;padding:14px;text-align:center}
.total .t1{font-size:13px;font-weight:600}
.total .t1 s{color:var(--accent);font-weight:800}
.total .t2{font-family:var(--serif);font-weight:700;color:var(--ink);font-size:15px;margin-top:2px}

/* oferta */
.obox{max-width:680px;margin:0 auto;background:#fff;border-radius:18px;padding:28px 24px;box-shadow:0 24px 60px rgba(0,0,0,.35)}
.obadge{text-align:center}
.obadge span{display:inline-block;background:var(--accent-soft);color:var(--accent);font-weight:800;font-size:11.5px;padding:5px 12px;border-radius:999px}
.obox h2{margin-top:10px}
.olay{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px;align-items:end}
.olist h4{margin:0 0 8px;font-family:var(--serif);color:var(--ink);font-size:15px}
.olist ul{list-style:none;padding:0;margin:0}
.olist li{font-size:12.5px;font-weight:600;color:var(--ink);padding:7px 0;border-bottom:1px solid var(--line);display:flex;gap:6px}
.olist li::before{content:"✔";color:var(--ink)}
.oimg{border-radius:12px;overflow:hidden;background:#111;margin-bottom:12px}
.oimg img{display:block;width:100%}
.pbox{border:1.5px solid var(--accent);border-radius:14px;padding:16px;text-align:center;background:linear-gradient(180deg,#fff,var(--tint))}
.p-old{color:var(--accent);font-weight:700;text-decoration:line-through;font-size:13px}
.p-tag{font-size:12.5px;color:var(--mute);margin-top:2px}
.p-main{font-family:var(--serif);font-weight:700;color:var(--ink);font-size:44px;line-height:1.05}
.p-type{font-size:12px;color:var(--mute)}
.p-save{display:inline-block;margin-top:8px;background:#e6f6ec;color:var(--green-d);font-weight:700;font-size:12px;padding:4px 10px;border-radius:999px}
.pbox .btn{width:100%;margin-top:12px;font-size:14px;padding:15px 14px}
.trust{font-size:11.5px;color:var(--mute);margin-top:8px}
.pays{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin-top:10px}
.pays span{font-size:10.5px;font-weight:800;border:1px solid var(--line);border-radius:6px;padding:3px 7px;color:var(--ink);background:#fff}
.ofoot{margin-top:18px;text-align:center;font-size:12.5px;font-style:italic;color:var(--mute)}

/* comentários */
.feed{max-width:400px;margin:26px auto 0;display:flex;flex-direction:column;gap:10px}
.post{background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px;box-shadow:0 4px 14px rgba(29,20,22,.06)}
.ph{display:flex;align-items:center;gap:8px}
.av{width:30px;height:30px;border-radius:50%;padding:2px;background:linear-gradient(45deg,#f9a73e,#d4141c,#8a3ab9);flex:none}
.av i{display:grid;place-items:center;width:100%;height:100%;border-radius:50%;background:#fff;border:2px solid #fff;font-style:normal;font-weight:800;font-size:11px;color:var(--mute)}
.who b{display:block;font-size:12.5px;color:var(--ink)}
.who span{font-size:11px;color:var(--mute)}
.heart{margin-left:auto;color:var(--accent);font-size:13px}
.post p{font-size:12.5px;margin-top:8px;color:var(--ink)}
.acts{display:flex;gap:12px;margin-top:6px;font-size:11px;color:var(--mute);font-weight:600}
.reply{margin:10px 0 0 14px;padding-left:12px;border-left:2px solid var(--gold)}
.ver{display:inline-grid;place-items:center;width:13px;height:13px;border-radius:50%;background:#3897f0;color:#fff;font-size:8px;margin-left:3px;vertical-align:1px}
.note{font-size:11.5px;color:var(--mute);text-align:center;margin-top:12px}

/* garantia */
.seal{width:96px;height:96px;margin:0 auto 14px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f7d77a,#c9952e 60%,#8f6418);display:grid;place-items:center;box-shadow:0 8px 20px rgba(143,100,24,.35)}
.seal div{width:76px;height:76px;border-radius:50%;background:var(--dark);border:2px solid #f3cf6c;display:grid;place-items:center;text-align:center;color:#f3cf6c;font-family:var(--serif);font-weight:700;line-height:.9;font-size:11px;text-transform:uppercase}
.seal b{display:block;font-size:30px}
.gsub{text-align:center;font-weight:700;color:var(--accent);font-size:13px;margin-top:6px}
.gcard{max-width:420px;margin:16px auto 0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;font-size:12.5px;display:flex;flex-direction:column;gap:10px;box-shadow:0 6px 20px rgba(29,20,22,.06)}
.gcard strong{color:var(--ink)}
.gcard .last{text-align:center;font-weight:700;color:var(--ink)}
.gbtn{text-align:center;margin-top:20px}
.btn.alt{background:var(--accent);box-shadow:0 6px 18px rgba(212,20,28,.35);text-transform:none;font-size:14px}
.btn.alt:hover{background:#a50f16}

/* sobre */
.about{display:grid;grid-template-columns:1.25fr .75fr;gap:28px;align-items:center}
.tag{display:inline-block;background:var(--accent-soft);color:var(--accent);font-weight:700;font-size:11px;padding:3px 10px;border-radius:999px}
.about h2{text-align:left;margin-top:8px}
.about .sub{font-weight:700;color:var(--ink);font-size:13.5px;margin-top:8px}
.about ul{list-style:none;padding:0;margin:12px 0;display:flex;flex-direction:column;gap:6px}
.about li{font-size:13px;font-weight:600;color:var(--ink);display:flex;gap:6px}
.about li::before{content:"✅";font-size:12px}
.about .txt{font-size:12.5px;color:var(--mute)}
.about img{width:100%;border-radius:14px;box-shadow:0 14px 34px rgba(29,20,22,.2);display:block}
.about-c{min-width:0}

/* cta final */
.final h2{color:#fff}
.final .lead{color:#f3cf6c;font-weight:700}
.urg{margin-top:18px;background:#fff6e8;border:1.5px solid #f0a33a;border-radius:12px;padding:12px 14px;text-align:center}
.urg h4{margin:0;color:#c26a00;font-size:12.5px;font-weight:800}
.urg p{font-size:12px;color:var(--mute);margin-top:4px}

/* faq */
.faq{max-width:520px;margin:24px auto 0;display:flex;flex-direction:column;gap:8px}
details{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px 14px}
summary{cursor:pointer;list-style:none;font-weight:700;font-size:13px;color:var(--ink);display:flex;justify-content:space-between;gap:10px}
summary::-webkit-details-marker{display:none}
summary::after{content:"⌄";color:var(--accent)}
details[open] summary::after{content:"⌃"}
details p{font-size:12.5px;color:var(--mute);margin-top:8px}
.fbtn{display:inline-block;margin-top:10px;background:var(--accent-soft);color:var(--ink);font-weight:700;font-size:12px;padding:6px 12px;border-radius:999px;text-decoration:none}

footer{background:var(--dark);color:#bfb3b5;text-align:center;padding-block:32px;font-size:12px}
footer .fb{font-family:var(--serif);font-weight:700;font-size:20px;color:#fff}
footer p{margin-top:8px}

@media (max-width:640px){
  section{padding-block:44px}
  .cards{grid-template-columns:1fr 1fr}
  .gal{grid-template-columns:repeat(3,1fr)}
  .minis{grid-template-columns:repeat(2,1fr)}
  .ck,.ideal ul,.bens,.bonus,.olay,.about{grid-template-columns:1fr}
  .about img{max-width:300px;margin:0 auto;order:-1}
  .obox{padding:22px 16px}
  .btn{width:100%}
}
/* ===== Identidade IALA: preto e vermelho, títulos fortes ===== */
:root{
  --ink:#ffffff; --text:#d9d1d1; --mute:#a39797;
  --bg:#0a0a0a; --tint:#121010; --card:#171313; --line:#2a2222;
  --dark:#000000; --accent:#e3121b; --accent-soft:rgba(227,18,27,.16);
  --gold:#e3b04b; --gold-bg:rgba(227,176,75,.08);
  --serif:"Outfit",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:dark;
}
h1,h2,h3{text-transform:none;letter-spacing:-.4px;line-height:1.12;font-weight:800}
h1 em,h2 em{font-style:normal}
.card .lbl{font-style:normal;text-transform:uppercase;letter-spacing:1.5px;font-family:var(--sans);font-weight:800;font-size:11px}
.card h3{font-size:18px}
.ben-h h3{font-size:16px}
.bcard h3{font-size:17px}
.hero{background:radial-gradient(ellipse 70% 60% at 50% 0%,rgba(227,18,27,.35),transparent 70%),var(--bg)}
.card,.mini,.incl,.ben,.bcard,.post,.gcard,details,.pays span{background:var(--card);border-color:var(--line);box-shadow:none}
.card.feat{border-color:var(--accent);background:linear-gradient(160deg,rgba(227,18,27,.18),var(--card) 60%)}
.ideal{background:linear-gradient(135deg,#2a0507,#120707);border:1px solid rgba(227,18,27,.4)}
.band{background:linear-gradient(90deg,#8f0c12,var(--accent) 55%,#8f0c12);text-transform:uppercase;letter-spacing:.5px}
.bnum{background:var(--accent)}
.val{background:rgba(255,255,255,.06);color:var(--ink)}
.val b{color:#3ddc7a}
.total .t2{color:var(--ink)}
.darksec{background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(227,18,27,.28),transparent 70%),#050505;border-block:1px solid var(--line)}
.obox{background:#111;border:1.5px solid var(--accent);box-shadow:0 24px 60px rgba(227,18,27,.18)}
.obadge span{background:var(--accent);color:#fff}
.pbox{background:linear-gradient(180deg,#1a1414,#120e0e)}
.p-old{color:#ff5a60}
.p-save{background:rgba(61,220,122,.12);color:#3ddc7a}
.olist li::before{color:var(--accent)}
.olist li{color:var(--ink)}
.oimg{border:1px solid var(--line)}
.ofoot{color:var(--mute)}
.av i{background:var(--card);border-color:var(--card)}
.reply{border-left-color:var(--accent)}
.seal div{background:#000}
.gsub{color:var(--accent)}
.final .lead{color:var(--gold)}
.urg{background:rgba(240,163,58,.08);border-color:#f0a33a}
.urg h4{color:#f0a33a}
.fbtn{background:var(--accent-soft);color:var(--ink)}
.tag{background:var(--accent);color:#fff}
.about img{border:1px solid var(--line);box-shadow:0 14px 34px rgba(0,0,0,.6)}
footer{border-top:1px solid var(--line)}
.btn{box-shadow:0 6px 0 #127a3a,0 10px 24px rgba(31,154,80,.3)}
.btn.alt{box-shadow:0 6px 0 #8f0c12}
/* barra de oferta */
.offerbar{background:var(--accent);color:#fff;text-align:center;font-weight:800;font-size:13px;letter-spacing:.3px;text-transform:uppercase;padding-block:10px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));border-bottom:2px solid #8f0c12}
.offerbar s{opacity:.75}
.offerbar b{background:#000;padding:2px 8px;border-radius:4px;margin-left:4px}
/* player limpo: só o play */
.vsl .ytwrap{position:absolute;inset:0;overflow:hidden;background:#000}
.vsl .ytwrap iframe{position:absolute;left:0;width:100%;top:-80px;height:calc(100% + 160px);border:0;pointer-events:none}
.vsl .cover,.vsl .play{z-index:2;transition:opacity .2s}
.vsl .cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 25%}
.vsl .shield{position:absolute;inset:0;z-index:3}
.vsl.playing .cover,.vsl.playing .play{opacity:0;pointer-events:none}
.vsl.loading .play span{animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
/* como funciona na prática */
.how{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center;margin-top:28px}
.how-c{display:flex;flex-direction:column;gap:12px;min-width:0}
.mod{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:12px;padding:16px 18px}
.mod h3{font-family:var(--sans);text-transform:none;font-size:15.5px;font-weight:800;margin-bottom:6px;letter-spacing:0}
.mod ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:4px}
.mod li{font-size:13.5px;color:var(--text);display:flex;gap:8px}
.mod li::before{content:"▪";color:var(--accent)}
.mod p{font-size:13.5px;color:var(--text)}
.how-img img{display:block;width:100%;max-width:100%}
@media (max-width:640px){.how{grid-template-columns:1fr}.how-img{order:-1}}
/* comentários estilo instagram */
.igfeed{columns:2;column-gap:14px;margin-top:28px}
.igc{background:#fff;color:#262626;border-radius:16px;padding:16px 16px 14px;box-shadow:0 10px 30px rgba(0,0,0,.35);min-width:0;break-inside:avoid;margin-bottom:14px;display:block}
.igc-row{display:flex;gap:12px;align-items:flex-start}
.igc-body{flex:1;min-width:0}
.igav{flex:none;width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;font-size:13px;box-shadow:0 0 0 2px #fff,0 0 0 4px #e1306c}
.igav.sm{width:28px;height:28px;font-size:10px}
